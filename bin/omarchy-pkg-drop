#!/bin/bash

# omarchy:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# omarchy:args=<packages...>
# omarchy:requires-sudo=true

set -eo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
platform=${OMARCHY_PLATFORM:-$("$script_dir/omarchy-platform" 2>/dev/null || echo arch)}
installed=()

selected_contains() {
  local candidate=$1
  local selected_package

  for selected_package in "${installed[@]}"; do
    [[ $selected_package == "$candidate" ]] && return 0
  done

  return 1
}

if [[ $platform == "debian" ]]; then
  if [[ -n ${OMARCHY_PATH:-} ]]; then
    omarchy_path=$OMARCHY_PATH
  elif [[ -f $script_dir/../install/debian/package-resolver.sh ]]; then
    omarchy_path=$(cd -- "$script_dir/.." && pwd)
  else
    omarchy_path=/usr/share/omarchy
  fi

  export OMARCHY_PATH=$omarchy_path
  source "$omarchy_path/install/debian/package-resolver.sh"

  for requested in "$@"; do
    IFS=$'\t' read -r _ packages _ < <(debian_package_record "$requested") || continue
    read -r -a resolved <<<"$packages"
    for package_name in "${resolved[@]}"; do
      if debian_packages_installed "$package_name" && ! selected_contains "$package_name"; then
        installed+=("$package_name")
      fi
    done
  done

  if ((${#installed[@]} > 0)); then
    privilege=()
    (( EUID == 0 )) || privilege=(sudo)
    "${privilege[@]}" apt-get purge -y "${installed[@]}"
  fi
else
  installed_package_names=$(pacman -Qq)

  for pkg in "$@"; do
    if printf '%s\n' "$installed_package_names" | grep -qxF "$pkg" && ! selected_contains "$pkg"; then
      installed+=("$pkg")
    fi
  done

  if ((${#installed[@]} > 0)); then
    sudo pacman -Rns --noconfirm "${installed[@]}"
  fi
fi
