#!/bin/bash

# omarchy:summary=Print when system packages were last upgraded

if [[ ${OMARCHY_PLATFORM:-$(omarchy-platform 2>/dev/null || echo arch)} == "debian" ]]; then
  last_upgrade=$(zgrep -hE ' (upgrade|install) ' /var/log/dpkg.log* 2>/dev/null | tail -1 | cut -d' ' -f1-2)
  [[ -n $last_upgrade ]] || exit 1
  date -d "$last_upgrade" "+%A, %B %d %Y at %H:%M"
else
  date -d "$(grep upgraded /var/log/pacman.log | tail -1 | sed -E 's/\[([^]]+)\].*/\1/')" "+%A, %B %d %Y at %H:%M"
fi
