#!/bin/bash

# omarchy:summary=Show a fuzzy-finder TUI for picking system packages to install.
# omarchy:requires-sudo=true

platform=${OMARCHY_PLATFORM:-$(omarchy-platform 2>/dev/null || echo arch)}

if [[ $platform == "debian" ]]; then
  preview_command='apt-cache show {1}'
else
  preview_command='pacman -Sii {1}'
fi

fzf_args=(
  --multi
  --preview "$preview_command"
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

if [[ $platform == "debian" ]]; then
  pkg_names=$(apt-cache pkgnames | sort -u | fzf "${fzf_args[@]}")
else
  pkg_names=$(pacman -Slq | fzf "${fzf_args[@]}")
fi

if [[ -n $pkg_names ]]; then
  source omarchy-sudo-keepalive

  echo "$pkg_names" | xargs omarchy-pkg-add
  omarchy-show-done
fi
