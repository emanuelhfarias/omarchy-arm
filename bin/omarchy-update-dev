#!/bin/bash

# omarchy:summary=Update the active Omarchy dev checkout

set -euo pipefail

platform=${OMARCHY_PLATFORM:-$(omarchy-platform 2>/dev/null || echo arch)}

if [[ $platform == "debian" && $OMARCHY_PATH == "/usr/share/omarchy" ]]; then
  [[ -d $OMARCHY_PATH/.git ]] || {
    echo -e "\e[33m\nSkip Omarchy source update (install is not a Git checkout)\e[0m"
    exit 0
  }

  echo -e "\e[32m\nUpdate Omarchy source checkout\e[0m"
  sudo git -C "$OMARCHY_PATH" pull --ff-only
  sudo env \
    OMARCHY_PLATFORM=debian \
    OMARCHY_PATH="$OMARCHY_PATH" \
    OMARCHY_INSTALL="$OMARCHY_PATH/install" \
    OMARCHY_INSTALL_USER="$USER" \
    PATH="$OMARCHY_PATH/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    bash -eE -c 'source "$OMARCHY_INSTALL/helpers/logging.sh"; source "$OMARCHY_INSTALL/debian/install-assets.sh"'
  exit 0
fi

[[ $OMARCHY_PATH != "/usr/share/omarchy" ]] || exit 0

if ! git -C "$OMARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMARCHY_PATH is not a git checkout: $OMARCHY_PATH" >&2
  exit 1
fi

upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Omarchy dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Omarchy dev checkout\e[0m"
git -C "$OMARCHY_PATH" pull --ff-only
